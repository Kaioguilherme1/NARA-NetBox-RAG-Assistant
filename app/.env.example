# Azure AI Foundry (endpoint compativel com OpenAI, termina em /openai/v1/)
OPENAI_API_KEY=coloque-sua-chave-do-foundry
OPENAI_BASE_URL=https://SEU-RECURSO.cognitiveservices.azure.com/openai/v1/
MODELO_CHAT=gpt-5.4
MODELO_EMBED=text-embedding-3-small

# PostgreSQL + pgvector. No docker-compose, o host e 'db'. Local, use 'localhost'.
DB_URI=postgresql://postgres:postgres@db:5432/rag

# Documentacao GitLab (NetBox)
DOCS_REPO_URL=
DOCS_REPO_BRANCH=main
DOCS_REPO_TOKEN=coloque-seu-token-de-leitura-git
DOCS_REPO_USERNAME=oauth2
DOCS_LOCAL_DIR=/tmp/docs-netbox
DOCS_LOCAL_ATTACH_DIR=documentos_local/anexos
NETBOX_IMPORTS_DIR=documentos_local/imports

# RAG top-k configuration
TOP_K_RAG_MAIN=8
TOP_K_RAG_FALLBACK=5
TOP_K_LIST_FONTS=200

# Otimizacao de custo e tokens
RAG_CACHE_TTL_SECONDS=300
RAG_CACHE_MAX_ENTRIES=256
MAX_RAG_CONTEXT_CHUNKS=6

